# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — for the in-app chat/practice feature
GOOGLE_AI_API_KEY=your-gemini-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron — protects /api/cron/keep-alive from public GET requests.
# Vercel sets this header automatically on its own cron invocations in production;
# generate any random string for this value and add it in Vercel's env var settings.
CRON_SECRET=your-random-secret
